{
  "name": "guymacyb243",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Guymacyb243 — Application Windows de cybersécurité réelle : Wi-Fi, Web & Apps, Laboratoire Docker, terminaux natifs. Pilote de vrais outils Linux via WSL 2.",
  "author": "Guyma Cyb Security Systems",
  "main": "desktop/electron-main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k -n ELECTRON,VITE -c yellow,cyan \"npm:dev:electron\" \"npm:dev:vite\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env GCYB_DEV=1 electron .",
    "build": "vite build",
    "build:server": "node desktop/build-server-bundle.js",
    "build:desktop": "vite build && node desktop/build-server-bundle.js && electron-builder --win nsis --x64",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production electron .",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dockerode": "^4.0.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sql.js": "^1.14.2",
    "sudo-prompt": "^9.2.1",
    "systeminformation": "^5.23.0",
    "vite": "^8.3.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "node-pty": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wait-on": "^8.0.1"
  }
}
